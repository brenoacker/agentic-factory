{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/triage.schema.json",
  "title": "Factory Triage Contract",
  "type": "object",
  "required": [
    "issue_number",
    "type",
    "impact",
    "root_cause",
    "evidence",
    "affected_paths",
    "needs_human"
  ],
  "properties": {
    "issue_number": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "enum": ["feature", "bug", "investigation", "discovery", "chore"] },
    "impact": { "type": "string", "enum": ["low", "medium", "high"] },
    "root_cause": { "type": "string", "minLength": 20 },
    "evidence": { "type": "string", "minLength": 15 },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "needs_human": { "type": "boolean" },
    "human_question": { "type": "string" }
  },
  "additionalProperties": false
}
