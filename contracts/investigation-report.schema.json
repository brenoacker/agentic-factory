{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/investigation-report.schema.json",
  "title": "Factory Investigation Report Contract",
  "type": "object",
  "required": [
    "issue_number",
    "question",
    "answer_summary",
    "evidence",
    "options_compared",
    "recommendation",
    "follow_up_tickets",
    "needs_human"
  ],
  "properties": {
    "issue_number": { "type": "integer", "minimum": 1 },
    "question": { "type": "string", "minLength": 10 },
    "answer_summary": { "type": "string", "minLength": 30 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 15 }
    },
    "options_compared": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["option", "pros", "cons"],
        "properties": {
          "option": { "type": "string", "minLength": 3 },
          "pros": { "type": "string", "minLength": 3 },
          "cons": { "type": "string", "minLength": 3 }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 15 },
    "follow_up_tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "type", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 5 },
          "type": { "type": "string", "enum": ["feature", "bug", "chore"] },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "needs_human": { "type": "boolean" }
  },
  "additionalProperties": false
}
