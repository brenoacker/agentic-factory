{
  "name": "agentic-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Local, single-operator Agentic Software Factory built on Tech Leads Club skills and tlc-spec-lean v2.2.0",
  "type": "module",
  "scripts": {
    "validate": "node packages/core/cli.mjs validate",
    "build:panel": "node scripts/build-panel.mjs",
    "sync-skills": "node scripts/sync-skills.mjs --verify-only",
    "lint": "node --check scripts/*.mjs packages/**/*.mjs",
    "selftest:spec": "python3 skills/vendor/tlc-spec-lean/scripts/selftest.py",
    "check:static": "npm run build:panel && npm run sync-skills && npm run validate && npm run selftest:spec",
    "test:unit": "node --test \"scripts/__test__/*.test.mjs\" \"packages/**/__test__/*.test.mjs\" \"apps/**/__test__/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run check:static && npm test",
    "panel": "node packages/core/cli.mjs panel --port 4310"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.28",
    "@playwright/test": "^1.52.0"
  },
  "dependencies": {
    "@cloudscape-design/components": "^3.0.1410",
    "@cloudscape-design/design-tokens": "^3.0.117",
    "@cloudscape-design/global-styles": "^1.0.72",
    "esbuild": "^0.28.2",
    "mermaid": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
